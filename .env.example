# Copy to .env and fill in with your own values. .env is gitignored.

# Root directory holding your exported statement files.
# Expected layout:
#   $FINANCE_DATA_DIR/bofa/credit/<export>_<last4>.csv
#   $FINANCE_DATA_DIR/bofa/debit/checkingTransactions.csv
#   $FINANCE_DATA_DIR/bofa/savings/savingsTransactions.csv
#   $FINANCE_DATA_DIR/fidelity/fidelityTransactions.csv
#   $FINANCE_DATA_DIR/parsed_data/            <- created by you, holds the output
FINANCE_DATA_DIR=/path/to/your/finances

# Filename suffix identifying your credit account's exported CSVs.
# Bank exports are named like "May2025_1234.csv", where 1234 is the account's last 4 digits.
CREDIT_FILE_SUFFIX=_0000.csv

# Account-name prefix your 401k provider uses to label employer plan rows
# (usually your employer's name as it appears in the 'Account' column).
RETIREMENT_ACCOUNT_PREFIX=YOUR_EMPLOYER

# Gross annual income, used as the savings rate denominator.
ANNUAL_INCOME=100000

# Monthly spending limits drawn as a reference line on the income vs. spending charts.
MONTHLY_SPENDING_LIMIT=1000
CREDIT_SPENDING_LIMIT=500
